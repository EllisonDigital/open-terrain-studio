config_version=5
[application]
config/name="OpenTerrainStudio Import Helper Tests"
[rendering]
renderer/rendering_method="gl_compatibility"
[editor_plugins]
enabled=PackedStringArray("res://addons/openterrainstudio_import/plugin.cfg")
